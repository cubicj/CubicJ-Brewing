{
  "compilerOptions": {
    "inlineSourceMap": true,
    "inlineSources": true,
    "module": "ESNext",
    "target": "ES2022",
    "allowJs": true,
    "strict": true,
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "lib": ["DOM", "ES2022"],
    "types": ["node"],
    "noEmit": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "src/**/*.json", "tests/**/*.ts"]
}
