{
  "name": "cubicj-brewing",
  "version": "0.6.0",
  "private": true,
  "scripts": {
    "dev": "node esbuild.config.mjs watch",
    "build": "npm run test && npm run check && node esbuild.config.mjs production",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "watch": "node esbuild.config.mjs watch",
    "lint": "eslint src/ tests/",
    "lint:fix": "eslint src/ tests/ --fix",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.0",
    "archiver": "^7.0.1",
    "esbuild": "^0.25.0",
    "eslint": "^10.0.3",
    "jsdom": "^29.0.0",
    "obsidian": "^1.13.1",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.56.1",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@stoprocent/noble": "^2.3.16"
  }
}
